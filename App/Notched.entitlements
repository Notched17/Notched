<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: lets Now Playing control Music and Spotify (#9, #15).
	     macOS still asks the user, per app, the first time. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened Runtime: lets Network read the Wi-Fi name (#29), which macOS
	     shares only with apps allowed to use Location. Asked for only when the
	     user turns on "Show the Wi-Fi network's name". -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
