#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# A tiny Now Playing source for testing Notched without a real player: a
# quiet tone, published through MPNowPlayingInfoCenter, obeying play/pause/
# next/previous/±15 s/seek. Options are documented in scripts/TestPlayer.swift
# (--title, --artist, --album, --duration, --live, --paused, --mute, --volume).
#
# Notched, like Control Center, only shows media from an app with a bundle
# identifier, so the source is built into build/TestPlayer.app
# (me.rkck.Notched.TestPlayer) the first time, and again when it changes.
#
# Usage: scripts/test-player [options]     Ctrl-C (or kill) quits.
set -euo pipefail
cd "$(dirname "$0")/.."
app="build/TestPlayer.app"
src="scripts/TestPlayer.swift"
bin="$app/Contents/MacOS/TestPlayer"
if [[ ! -x "$bin" || "$src" -nt "$bin" ]]; then
  mkdir -p "$app/Contents/MacOS"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>me.rkck.Notched.TestPlayer</string>
  <key>CFBundleName</key><string>Test Player</string>
  <key>CFBundleExecutable</key><string>TestPlayer</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
  xcrun swiftc -O -suppress-warnings "$src" -o "$bin"
  codesign --force --sign - "$app" >/dev/null 2>&1
fi
exec "$bin" "$@"
